# Copy this file to ".env" and fill in the values. Never commit ".env".

# --- FastAPI backend ---
# Key the backend requires on every request (header: Authorization: Bearer <value>).
# Generate one yourself, for example with: openssl rand -hex 32
BACKEND_API_KEY=change-me

# Allowed CORS origins, comma-separated (local Next.js dev by default).
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Modal ---
# Modal token (created via `modal token new`), needed to deploy/run on Modal.
# Do NOT put the value here in plain text for real use: use `modal secret create`
# and reference the secret from backend/app/modal_app.py. This field is just a local reminder.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# GPU used by the Modal deployment. Only T4 and L4 are allowed (A100 is
# explicitly forbidden for Qwen 4B, see backend/app/gpu_config.py).
# L4 is recommended (nearly as fast as A100, cheaper).
MODAL_GPU_TYPE=L4

# --- Documents uploaded from the Library (see app/document_manager.py) ---
# Local folder or mount point of the "aftech-document-store" Modal Volume
# where the PDFs, the registry and the rebuildable index are stored.
DOCUMENT_STORE_DIR=data/document_store
# Maximum size accepted per uploaded PDF, in MB.
MAX_UPLOAD_MB=25

# --- Next.js frontend ---
# The frontend has its OWN environment file: frontend/.env.local
# (see frontend/.env.local.example). BACKEND_BASE_URL and BACKEND_API_KEY
# are redefined there, server-side only (never NEXT_PUBLIC_).
