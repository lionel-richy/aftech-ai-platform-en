# Copy this file to "frontend/.env.local" (never committed — already in
# frontend/.gitignore). Next.js loads it automatically.
#
# These two variables are read ONLY server-side (lib/backend.ts, which
# imports "server-only"). The browser never sees them: it always calls
# our /api/* routes, never Modal directly.

# Backend URL. Locally (backend/scripts/run_local.sh):
#   BACKEND_BASE_URL=http://localhost:8000
# Once deployed on Modal, the URL printed by `modal deploy`:
#   BACKEND_BASE_URL=https://<your-workspace>--aftech-ai-platform-web.modal.run
BACKEND_BASE_URL=http://localhost:8000

# Same value as the Modal secret "aftech-backend-secrets" (key BACKEND_API_KEY).
# NEVER prefix with NEXT_PUBLIC_ — that would expose it in the browser bundle.
BACKEND_API_KEY=

# URL of the "availability" Modal function (CPU only, WITHOUT a GPU — see
# backend/app/modal_app.py). Deliberately SEPARATE from BACKEND_BASE_URL
# (which points to the GPU "web" container): this is the URL the frontend
# automatically polls (every 30s) to check whether the API is reachable,
# WITHOUT ever waking or keeping the GPU active. No key required (it
# returns no sensitive information).
# Locally (backend/scripts/run_local.sh), there is only one server:
#   BACKEND_AVAILABILITY_URL=http://localhost:8000
# Once deployed on Modal, the URL printed by `modal deploy` for the
# availability() function:
#   BACKEND_AVAILABILITY_URL=https://<your-workspace>--aftech-ai-platform-availability.modal.run
BACKEND_AVAILABILITY_URL=http://localhost:8000
